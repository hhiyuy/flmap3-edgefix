<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flmap_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, parameter presets and RViz configuration for the split
    "edge mapping + remote visualization" architecture.
  </description>
  <maintainer email="cj126050@users.noreply.github.com">FLMap.2 contributors</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>flmap_bridge</exec_depend>
  <exec_depend>flmap_accumulator</exec_depend>
  <!--
    fast_lio2 / livox_ros_driver2 / go2_fastlio 是「狗端建图」专属依赖，
    由 edge_mapping.launch.py 使用，需要 Livox-SDK2。
    PC 端远程可视化（pc_view.launch.py）只用到 flmap_accumulator + rviz2，
    因此这三个依赖不再挂在 flmap_bringup 上，避免 PC 端被迫安装 Livox-SDK2。
    狗端完整编译请用 ./setup.sh（会自动安装/准备 Livox-SDK2）。
  -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
